# NVIDIA NIM API Key (required — get one at https://build.nvidia.com)
NVIDIA_API_KEY=

# NVIDIA NIM base URL (default works for most users)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Primary model — fast, optimized for coding/technical MCQs
PRIMARY_MODEL=deepseek-ai/deepseek-v4-flash

# Fallback model — robust, broader knowledge base
FALLBACK_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Server port (optional, defaults to 3000)
PORT=3000
